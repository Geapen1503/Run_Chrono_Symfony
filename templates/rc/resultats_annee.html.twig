{% extends 'partials/layouts/master.html.twig' %}

{% block page_title %}Résultats {{ annee }}{% endblock %}
{% block head_title %}Résultats {{ annee }}{% endblock %}
{% block head_sub_title %}Années précédentes{% endblock %}

{% block page_contents %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Barre d'outils supérieure : navigation rapide entre les années #}
    <div class="card mb-4 border shadow-sm">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <a href="{{ path('rc_resultats_annees_precedentes') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="ri-arrow-left-line me-1"></i>Toutes les années
                    </a>
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                        <span>Éditions {{ annee }}</span>
                    </h5>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-1">
                    <span class="text-muted fs-12 fw-semibold me-2 d-none d-md-inline">Saisons :</span>
                    {% for item in annees %}
                        <a href="{{ path('rc_resultats_annee', {annee: item.annee}) }}"
                           class="btn btn-sm {{ item.annee == annee ? 'btn-success fw-bold' : 'btn-outline-secondary' }}">
                            {{ item.annee }}
                        </a>
                    {% endfor %}
                </div>

                <div>
                    <span class="badge bg-success-subtle text-success fs-13 px-3 py-2 fw-semibold">
                        <i class="ri-trophy-line me-1"></i>{{ evenements|length }} événement{{ evenements|length > 1 ? 's' : '' }} en {{ annee }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    {# Barre de recherche dynamique pour l'année en cours #}
    <div class="card mb-4 border shadow-sm">
        <div class="card-body p-3">
            <div class="row align-items-center g-2">
                <div class="col-md-8 col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="ri-search-line"></i>
                        </span>
                        <input type="text"
                               id="eventSearchInput"
                               class="form-control border-start-0 ps-0"
                               placeholder="Filtrer en direct par nom de course ou d'événement (ex: Ekiden, Trail, 10km)..."
                               autocomplete="off">
                        <button class="btn btn-light border d-none" id="clearSearchBtn" type="button" title="Effacer le filtre">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-4 col-12 text-md-end text-muted fs-13">
                    <span id="searchCounter">
                        Affichage de <strong>{{ evenements|length }}</strong> sur <strong>{{ evenements|length }}</strong> événement(s)
                    </span>
                </div>
            </div>
        </div>
    </div>

    {# Grille des événements ou message vide #}
    {% if evenements is empty %}
        <div class="row">
            <div class="col-xl-8 col-lg-10">
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-info mb-0" role="status">
                            <i class="ri-information-line me-1"></i>
                            Aucun événement répertorié pour l'année {{ annee }}.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div id="noEventsMatchAlert" class="alert alert-warning d-none mb-4" role="alert">
            <i class="ri-alert-line me-1"></i>
            Aucun événement ne correspond à votre filtre de recherche.
        </div>

        {% include 'rc/_event_cards.html.twig' with {evenements: evenements} %}
    {% endif %}

{% endblock %}

{% block vendor_scripts %}
    <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('eventSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const counter = document.getElementById('searchCounter');
            const noMatchAlert = document.getElementById('noEventsMatchAlert');
            const cards = document.querySelectorAll('.event-card');
            const total = cards.length;

            if (!searchInput || total === 0) return;

            function filterEvents() {
                const query = searchInput.value.trim().toLowerCase();

                if (query.length > 0) {
                    clearBtn.classList.remove('d-none');
                } else {
                    clearBtn.classList.add('d-none');
                }

                let visibleCount = 0;

                cards.forEach(card => {
                    const title = card.getAttribute('data-event-title') || '';
                    const date = card.getAttribute('data-event-date') || '';
                    const courses = card.getAttribute('data-event-courses') || '';
                    const haystack = (title + ' ' + date + ' ' + courses).toLowerCase();

                    if (!query || haystack.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (counter) {
                    counter.innerHTML = `Affichage de <strong>${visibleCount}</strong> sur <strong>${total}</strong> événement(s)`;
                }

                if (noMatchAlert) {
                    if (visibleCount === 0) {
                        noMatchAlert.classList.remove('d-none');
                    } else {
                        noMatchAlert.classList.add('d-none');
                    }
                }
            }

            searchInput.addEventListener('input', filterEvents);

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    filterEvents();
                    searchInput.focus();
                });
            }
        });
    </script>
{% endblock %}
