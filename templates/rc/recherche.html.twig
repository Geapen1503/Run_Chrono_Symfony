{% extends 'partials/layouts/master.html.twig' %}

{% block page_title %}Recherche info coureur{% endblock %}
{% block head_title %}Recherche info coureur{% endblock %}
{% block head_sub_title %}Participants — Phase 2.1{% endblock %}

{% block page_contents %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1">Événement actif (console /rc)</h6>
                {% if evenement %}
                    <p class="mb-0 text-muted">
                        <strong>{{ evenement.evenement }}</strong>
                        — {{ evenement.lib_date_evenement|default(evenement.date_evenement) }}
                        <br>
                        <code>{{ evenement.id_html }}</code>
                        · table <code>{{ evenement.table_run }}</code>
                    </p>
                {% else %}
                    <p class="mb-0 text-warning">Aucun événement actif défini.</p>
                {% endif %}
            </div>
            <a href="{{ path('rc_participants_evenement_actif') }}" class="btn btn-outline-primary btn-sm">
                Changer l'événement actif
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-xl-10">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-1">Recherche coureur</h5>
                    <p class="mb-0 card-subtitle fs-13 text-muted">
                        Équivalent legacy <code>info_coureur.php</code> — données table <code>run_*</code> de l'édition active.
                    </p>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('rc_participants_recherche') }}" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label" for="dossard">Dossard</label>
                            <input type="text" class="form-control" id="dossard" name="dossard" placeholder="ex. 1234" value="{{ dossard }}" inputmode="numeric" autocomplete="off">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="nom">Nom</label>
                            <input type="text" class="form-control" id="nom" name="nom" placeholder="Nom ou nom prénom" value="{{ nom }}" autocomplete="off">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="prenom">Prénom</label>
                            <input type="text" class="form-control" id="prenom" name="prenom" placeholder="Prénom (optionnel)" value="{{ prenom }}" autocomplete="off">
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100" {{ evenement ? '' : 'disabled' }}>
                                <i class="ri-search-line me-1"></i>Rechercher
                            </button>
                        </div>
                        <div class="col-12">
                            <details class="text-muted fs-13">
                                <summary class="cursor-pointer">Mode legacy — un seul champ</summary>
                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <input type="text" class="form-control" name="q" placeholder="Dossard ou nom (comme info_coureur.php)" value="{{ q }}">
                                    </div>
                                </div>
                            </details>
                        </div>
                    </form>

                    {% if erreur_recherche %}
                        <div class="alert alert-danger" role="alert">{{ erreur_recherche }}</div>
                    {% endif %}

                    {% if recherche_effectuee and recherche and not erreur_recherche %}
                        {% if recherche.limite_atteinte %}
                            <div class="alert alert-warning" role="status">
                                Plus de 150 résultats : seuls les 150 premiers sont affichés. Affinez la recherche.
                            </div>
                        {% endif %}

                        <h6 class="mb-3">
                            {{ recherche.resultats|length }} résultat(s)
                            <span class="text-muted fw-normal">— {{ recherche.table_run }}</span>
                        </h6>

                        {% if recherche.resultats is empty %}
                            <div class="alert alert-info mb-0" role="status">Aucun coureur trouvé pour cette recherche.</div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Course</th>
                                            <th>Dossard</th>
                                            <th>Catégorie</th>
                                            <th>Sexe</th>
                                            <th>Nom / prénom</th>
                                            <th>Club</th>
                                            <th>Licence</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for p in recherche.resultats %}
                                            <tr class="{{ p.abandon ? 'table-secondary' : '' }}">
                                                <td>{{ p.distance }}</td>
                                                <td><strong>{{ p.dossard }}</strong></td>
                                                <td>{{ p.categorie_affichee }}</td>
                                                <td>{{ p.sexe }}</td>
                                                <td>
                                                    {{ p.nom_complet }}
                                                    {% if p.abandon %}<span class="badge bg-secondary ms-1">Abandon</span>{% endif %}
                                                    {% if p.litige.est_en_litige %}<span class="badge bg-warning text-dark ms-1" title="{{ p.litige.motif }}">Litige</span>{% endif %}
                                                </td>
                                                <td>{{ p.club }}</td>
                                                <td>{{ p.licence }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    {% elseif recherche_effectuee and evenement %}
                        {# erreur déjà affichée #}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block vendor_scripts %}
    <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
{% endblock %}