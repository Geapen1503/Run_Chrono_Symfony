{% extends 'partials/layouts/master.html.twig' %}

{% block page_title %}{{ titre }}{% endblock %}
{% block head_title %}{{ titre }}{% endblock %}
{% block head_sub_title %}Résultats spéciaux{% endblock %}

{% block page_contents %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-body bg-light-subtle p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <span class="badge bg-primary fs-13 px-3 py-2 mb-2">
                                <i class="ri-award-line me-1"></i>Résultats Spécifiques
                            </span>
                            <h4 class="mb-1 text-dark fw-bold">{{ titre }}</h4>
                        </div>
                        <div>
                            <a href="{{ path('rc_resultats_classements') }}" class="btn btn-outline-secondary">
                                <i class="ri-arrow-left-line me-1"></i>Retour aux événements
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if type in ['biathrun_finale', 'biathrun_qualifies', 'biathrun_qualif_hf'] %}
        <div class="row g-4 mb-4">
            <div class="col-xl-6 col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-danger-subtle border-0 py-3">
                        <h5 class="card-title text-danger mb-0 d-flex align-items-center gap-2">
                            <i class="ri-women-line fs-18"></i> Femmes / Dames ({{ femmes|length }})
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 50px;">Rang</th>
                                    <th>Nom Prénom</th>
                                    {% if type == 'biathrun_finale' %}
                                        <th>Catégorie</th>
                                        <th class="text-end">Chrono Final</th>
                                    {% else %}
                                        <th class="text-end">Chrono 1</th>
                                        <th class="text-end">Chrono 2</th>
                                        <th class="text-end">Cumul</th>
                                        <th class="text-center">Nb</th>
                                        <th class="text-center">Statut</th>
                                    {% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in femmes %}
                                    <tr>
                                        <td class="text-center fw-bold">{{ loop.index }}</td>
                                        <td>
                                            <div class="fw-semibold text-dark">{{ r.nom_prenom|raw }}</div>
                                            {% if r.club is defined and r.club %}
                                                <small class="text-muted fs-11">{{ r.club }}</small>
                                            {% endif %}
                                        </td>
                                        {% if type == 'biathrun_finale' %}
                                            <td><span class="badge bg-light text-dark border">{{ r.categorie }}</span></td>
                                            <td class="text-end fw-bold text-success font-monospace">{{ r.chrono_final }}</td>
                                        {% else %}
                                            <td class="text-end font-monospace fs-12">{{ r.chrono_1|default('-') }}</td>
                                            <td class="text-end font-monospace fs-12">{{ r.chrono_2|default('-') }}</td>
                                            <td class="text-end fw-bold text-success font-monospace">{{ r.cumul_chrono|default('-') }}</td>
                                            <td class="text-center">{{ r.nb_courses }}</td>
                                            <td class="text-center">
                                                {% if r.qualif is defined and r.qualif %}
                                                    <span class="badge bg-success px-2 py-1">QUALIF</span>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                    </tr>
                                {% else %}
                                    <tr><td colspan="7" class="text-center py-3 text-muted">Aucune concurrente.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-xl-6 col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info-subtle border-0 py-3">
                        <h5 class="card-title text-info mb-0 d-flex align-items-center gap-2">
                            <i class="ri-men-line fs-18"></i> Hommes ({{ hommes|length }})
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 50px;">Rang</th>
                                    <th>Nom Prénom</th>
                                    {% if type == 'biathrun_finale' %}
                                        <th>Catégorie</th>
                                        <th class="text-end">Chrono Final</th>
                                    {% else %}
                                        <th class="text-end">Chrono 1</th>
                                        <th class="text-end">Chrono 2</th>
                                        <th class="text-end">Cumul</th>
                                        <th class="text-center">Nb</th>
                                        <th class="text-center">Statut</th>
                                    {% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in hommes %}
                                    <tr>
                                        <td class="text-center fw-bold">{{ loop.index }}</td>
                                        <td>
                                            <div class="fw-semibold text-dark">{{ r.nom_prenom|raw }}</div>
                                            {% if r.club is defined and r.club %}
                                                <small class="text-muted fs-11">{{ r.club }}</small>
                                            {% endif %}
                                        </td>
                                        {% if type == 'biathrun_finale' %}
                                            <td><span class="badge bg-light text-dark border">{{ r.categorie }}</span></td>
                                            <td class="text-end fw-bold text-success font-monospace">{{ r.chrono_final }}</td>
                                        {% else %}
                                            <td class="text-end font-monospace fs-12">{{ r.chrono_1|default('-') }}</td>
                                            <td class="text-end font-monospace fs-12">{{ r.chrono_2|default('-') }}</td>
                                            <td class="text-end fw-bold text-success font-monospace">{{ r.cumul_chrono|default('-') }}</td>
                                            <td class="text-center">{{ r.nb_courses }}</td>
                                            <td class="text-center">
                                                {% if r.qualif is defined and r.qualif %}
                                                    <span class="badge bg-success px-2 py-1">QUALIF</span>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                    </tr>
                                {% else %}
                                    <tr><td colspan="7" class="text-center py-3 text-muted">Aucun concurrent.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    {% elseif type == 'biathrun_jeunes' %}
        <div class="row g-4 mb-4">
            <div class="col-xl-6 col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary-subtle border-0 py-3">
                        <h5 class="card-title text-primary mb-0">Ados (2011-2014)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 50px;">Rang</th>
                                    <th>Nom Prénom</th>
                                    <th class="text-center">Sexe</th>
                                    <th class="text-end">Chrono 1</th>
                                    <th class="text-end">Chrono 2</th>
                                    <th class="text-end">Cumul</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in ados %}
                                    <tr>
                                        <td class="text-center fw-bold">{{ loop.index }}</td>
                                        <td class="fw-semibold">{{ r.nom_prenom|raw }}</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">{{ r.sexe }}</span></td>
                                        <td class="text-end font-monospace fs-12">{{ r.chrono_1|default('-') }}</td>
                                        <td class="text-end font-monospace fs-12">{{ r.chrono_2|default('-') }}</td>
                                        <td class="text-end fw-bold text-success font-monospace">{{ r.cumul_chrono|default('-') }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center py-3 text-muted">Aucun jeune.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-xl-6 col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-success-subtle border-0 py-3">
                        <h5 class="card-title text-success mb-0">Enfants (2015-2018)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 50px;">Rang</th>
                                    <th>Nom Prénom</th>
                                    <th class="text-center">Sexe</th>
                                    <th class="text-end">Chrono 1</th>
                                    <th class="text-end">Chrono 2</th>
                                    <th class="text-end">Cumul</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in enfants %}
                                    <tr>
                                        <td class="text-center fw-bold">{{ loop.index }}</td>
                                        <td class="fw-semibold">{{ r.nom_prenom|raw }}</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">{{ r.sexe }}</span></td>
                                        <td class="text-end font-monospace fs-12">{{ r.chrono_1|default('-') }}</td>
                                        <td class="text-end font-monospace fs-12">{{ r.chrono_2|default('-') }}</td>
                                        <td class="text-end fw-bold text-success font-monospace">{{ r.cumul_chrono|default('-') }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center py-3 text-muted">Aucun enfant.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    {% elseif type == 'challenge_entreprises' %}
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 60px;">Rang</th>
                                    <th>Équipe</th>
                                    <th class="text-center" style="width: 80px;">Catégorie</th>
                                    <th>Coureurs & Temps individuels</th>
                                    <th class="text-end" style="width: 140px;">Temps Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for eq in equipes %}
                                    <tr>
                                        <td class="text-center fw-bold fs-14">
                                            {% if loop.index == 1 %}🥇 1
                                            {% elseif loop.index == 2 %}🥈 2
                                            {% elseif loop.index == 3 %}🥉 3
                                            {% else %}{{ loop.index }}
                                            {% endif %}
                                        </td>
                                        <td class="fw-bold text-dark fs-14">{{ eq.club }}</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary-subtle text-primary">{{ eq.sexe_club }}</span>
                                        </td>
                                        <td>
                                            {% set coureursListe = eq.coureurs|split('||') %}
                                            <ul class="list-unstyled mb-0 d-flex flex-wrap gap-2">
                                                {% for c in coureursListe %}
                                                    <li>
                                                        <span class="badge bg-light text-dark border fw-normal fs-12">
                                                            <i class="ri-user-line me-1"></i>{{ c }}
                                                        </span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </td>
                                        <td class="text-end fw-bold text-success font-monospace fs-14">{{ eq.chrono_total }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Aucune équipe éligible trouvée.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    {% elseif type in ['relais', 'vetathlon', 'ekiden'] %}
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light fs-12 text-muted text-uppercase">
                                <tr>
                                    <th class="text-center" style="width: 60px;">Place</th>
                                    <th class="text-center" style="width: 80px;">Dossard</th>
                                    <th>Équipe / Participant</th>
                                    <th class="text-center">Passages / Relais</th>
                                    {% if type == 'relais' %}
                                        <th class="text-center">Distance</th>
                                    {% endif %}
                                    <th class="text-end">Heure dernier passage</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in lignes %}
                                    <tr>
                                        <td class="text-center fw-bold">{{ loop.index }}</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">#{{ r.dossard }}</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">{{ r.nom_prenom|raw }}</div>
                                            {% if r.club is defined and r.club %}
                                                <small class="text-muted fs-11">{{ r.club }}</small>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1">
                                                {{ r.nb_passage }} passage{{ r.nb_passage > 1 ? 's' : '' }}
                                            </span>
                                        </td>
                                        {% if type == 'relais' %}
                                            <td class="text-center fw-semibold text-secondary">
                                                {{ r.distance_km }} km
                                            </td>
                                        {% endif %}
                                        <td class="text-end font-monospace fw-bold text-success fs-13">
                                            {{ r.heure_dernier_passage|default('-') }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center py-4 text-muted">Aucune donnée disponible.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block vendor_scripts %}
    <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
{% endblock %}
