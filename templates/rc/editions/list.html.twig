{% extends 'partials/layouts/master.html.twig' %}

{% block page_title %}Éditions{% endblock %}
{% block head_title %}Éditions{% endblock %}
{% block head_sub_title %}Catalogue{% endblock %}

{% block page_contents %}
    {% if db_error %}
        <div class="alert alert-warning" role="alert">
            Connexion catalogue impossible (la page reste utilisable pour créer une édition après configuration MySQL).
            <br><small class="text-muted">{{ db_error }}</small>
        </div>
    {% endif %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">Éditions enregistrées dans <code>param_inscription_manuelle</code>.</p>
        <a class="btn btn-primary" href="{{ path('rc_editions_new') }}">
            <i class="ri-add-line"></i> Nouvelle édition
        </a>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>id_html</th>
                        <th>Événement</th>
                        <th>run_*</th>
                        <th>dag_import_*</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for row in editions %}
                    <tr>
                        <td>{{ row.date_evenement }}</td>
                        <td><code>{{ row.id_html }}</code></td>
                        <td>{{ row.evenement }}</td>
                        <td><small>{{ row.table_run }}</small></td>
                        <td><small>{{ row.table_dag }}</small></td>
                        <td>
                            <a href="{{ path('rc_editions_edit', { idHtml: row.id_html }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-muted p-4">Aucune édition (connexion MySQL ou table vide).</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block vendor_scripts %}
    <script type="module" src="{{ asset('assets/js/app.js') }}"></script>
{% endblock %}