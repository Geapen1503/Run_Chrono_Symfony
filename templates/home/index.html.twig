{% extends 'base.html.twig' %}

{% block title %}Accueil - RunChrono{% endblock %}

{% block body %}
    <style>
        .exemple-wrapper { margin: 2em auto; max-width: 800px; font-family: sans-serif; }
    </style>

    <div class="exemple-wrapper">
        <h1>{{ titre_page }}</h1>

        {% if app.user %}
            <p>Connecté : <strong>{{ app.user.userIdentifier }}</strong></p>
            <p><a href="{{ path('app_logout') }}">Se déconnecter</a></p>
        {% else %}
            <p>Vous n'êtes pas connecté.</p>
            <p><a href="{{ path('app_login') }}">Aller à la page de connexion</a></p>
        {% endif %}
    </div>
{% endblock %}
