{% extends 'partials/layouts/master2.html.twig' %}

{% block title %}Vector Maps{% endblock %}

{% block head_title %}Vector Maps{% endblock %}
{% block head_sub_title %}Home{% endblock %}

{% set buttonTitle = 'Share' %}
{% set modalTarget = 'shareModal' %}
{% block stylesheets %}
  <!-- plugin css -->
    <link rel="stylesheet" type="text/css" href="assets/libs/jsvectormap/jsvectormap.min.css">
{% endblock %}
{% block page_contents %}


    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">World Map Markers</h5>
                </div>
                <div class="card-body">
                    <div id="world-map" class="min-h-320px"></div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card mb-0">
                <div class="card-header">
                    <h5 class="card-title mb-0">World Map With Marker Lines</h5>
                </div>
                <div class="card-body">
                    <div id="world-map-markers-line" class="min-h-320px"></div>
                </div>
            </div>
        </div>
    </div>

    
{% endblock %}

{% block vendor_scripts %}
    <!-- Vector map-->
    <script src="assets/libs/jsvectormap/jsvectormap.min.js"></script>
    <script src="assets/libs/jsvectormap/maps/world.js"></script>

    <!-- vector-maps init -->
    <script src="assets/js/maps/vector-maps.init.js"></script>

    <!-- App js -->
    <script type="module" src="assets/js/app.js"></script>
{% endblock %}