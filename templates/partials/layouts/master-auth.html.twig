<!DOCTYPE html>
<html lang="en">

<head>
    {% block head_meta %}
        {% include 'partials/title-meta.html.twig' with {'title': block('page_title')|default('Dashboard')} %}
    {% endblock %}
    
    {% block head_css %}
        {% include 'partials/head-css.html.twig' with {'auth': block('auth_layout')|default(null)} %}
    {% endblock %}
    
    {% block head_scripts %}
        {# Optional head scripts #}
    {% endblock %}
    
    {% block stylesheets %}{% endblock %}
</head>

<body>
    {# Header, Sidebar, Preloader - only shown on non-auth pages #}
    {% if not is_auth_page|default(false) %}
        {% include 'partials/header.html.twig' %}
        {% include 'partials/sidebar.html.twig' %}
        {% include 'partials/preloader.html.twig' %}
    {% endif %}

    {# Main content area #}
    {% block body %}
        {% block page_contents %}
            <p>Default content</p>
        {% endblock %}
    {% endblock %}

    {# JavaScript includes #}
    {% block javascripts %}
        {% include 'partials/vendor-scripts.html.twig' %}
    {% endblock %}
    
    {% block page_scripts %}{% endblock %}
</body>

</html>