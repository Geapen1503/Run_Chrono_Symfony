{# Barre de navigation Herozi (layout horizontal — console /rc) #}
<aside class="app-sidebar">
    <div class="app-sidebar-logo px-6 justify-content-center align-items-center">
        <a href="{{ path('rc_home') }}">
            <img height="35" class="app-sidebar-logo-default" alt="RunChrono" src="{{ asset('assets/images/avatar/logo-runchrono.png') }}">
            <img height="40" class="app-sidebar-logo-minimize" alt="RunChrono" src="{{ asset('assets/images/avatar/logo-runchrono.png') }}">
        </a>
    </div>
    <nav class="app-sidebar-menu nav nav-pills flex-column fs-6" id="sidebarMenu" aria-label="Navigation principale">
        {% include 'partials/sidebar-menu-items.html.twig' %}
    </nav>
</aside>
<div class="horizontal-overlay"></div>

{# Sidebar mobile #}
<div class="offcanvas offcanvas-md offcanvas-start small-screen-sidebar" data-bs-scroll="true" tabindex="-1" id="smallScreenSidebar" aria-labelledby="smallScreenSidebarLabel">
    <div class="offcanvas-header hstack border-bottom">
        <div class="app-sidebar-logo">
            <a href="{{ path('rc_home') }}">
                <img height="35" class="app-sidebar-logo-default h-25px" alt="RunChrono" src="{{ asset('assets/images/avatar/logo-runchrono.png') }}">
                <img height="40" class="app-sidebar-logo-minimize" alt="RunChrono" src="{{ asset('assets/images/avatar/logo-runchrono.png') }}">
            </a>
        </div>
        <button type="button" class="btn-close bg-transparent" data-bs-dismiss="offcanvas" aria-label="Fermer">
            <i class="ri-close-line"></i>
        </button>
    </div>
    <div class="offcanvas-body p-0">
        <aside class="app-sidebar">
            <nav class="app-sidebar-menu nav nav-pills flex-column fs-6" aria-label="Navigation principale">
                {% include 'partials/sidebar-menu-items.html.twig' %}
            </nav>
        </aside>
    </div>
</div>
