{% extends 'partials/layouts/master2.html.twig' %}

{% block title %}Apex Polararea Chart{% endblock %}

{% block head_title %}Polararea Chart{% endblock %}
{% block head_sub_title %}ApexChat
{% endblock %}

{% set buttonTitle = 'Share' %}
{% set modalTarget = 'shareModal' %}

{% block page_contents %}

  <div class="row g-4">
    <!-- Basic Radar Chart -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 mb-0">
        <div class="card-header">
          <h6 class="card-title mb-0 fw-semibold">Basic Polararea Chart</h6>
        </div>
        <div class="card-body px-0">
          <div id="basic_polararea_chart" class="apexcharts-container"></div>
        </div>
      </div>
    </div>

    <!-- Monochrome Chart -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 mb-0">
        <div class="card-header">
          <h6 class="card-title mb-0 fw-semibold">Monochrome Chart</h6>
        </div>
        <div class="card-body px-0">
          <div id="monochrome_chart" class="apexcharts-container"></div>
        </div>
      </div>
    </div>

  </div>
{% endblock %}

{% block vendor_scripts %}
  <!-- ApexChat js -->
  <script src="assets/libs/apexcharts/apexcharts.min.js"></script>

  <!-- ApexChat Polar init -->
  <script src="assets/js/charts/apexcharts-config.init.js"></script>
  <script src="assets/js/charts/apexcharts-polar.init.js"></script>

  <!-- App js -->
  <script type="module" src="assets/js/app.js"></script>
{% endblock %}