{% extends 'partials/layouts/master2.html.twig' %}

{% block title %}Google Maps{% endblock %}

{% block head_title %}Google Maps{% endblock %}
{% block head_sub_title %}Home{% endblock %}

{% set buttonTitle = 'Share' %}
{% set modalTarget = 'shareModal' %}

{% block page_contents %}

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <div class="card mb-0 h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Basic Map</h5>
                </div>
                <div class="card-body">
                    <div class="w-100 min-h-320px" id="basic_gmap"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card mb-0 h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Map With Marker</h5>
                </div>
                <div class="card-body">
                    <div class="w-100 min-h-320px" id="gmap_with_marker"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card mb-0 h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Map With Overlays</h5>
                </div>
                <div class="card-body">
                    <div class="w-100 min-h-320px" id="gmap_with_overlays"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card mb-0 h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Map Type</h5>
                </div>
                <div class="card-body">
                    <div class="w-100 min-h-320px" id="gmap_map_type"></div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block vendor_scripts %}

    <!-- google maps api -->
    <script src="http://maps.google.com/maps/api/js"></script>

    <!-- Google Map js -->
    <script src="assets/libs/gmaps/gmaps.min.js"></script>

    <!-- Google Map init -->
    <script src="assets/js/maps/google-map.init.js"></script>

    <!-- App js -->
    <script type="module" src="assets/js/app.js"></script>
{% endblock %}